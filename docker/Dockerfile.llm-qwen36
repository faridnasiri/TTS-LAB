# syntax=docker/dockerfile:1
# ═══════════════════════════════════════════════════════════════════
# TIER 3 — llm-qwen36 (Qwen 3.6 LLM via pre-built llama.cpp)
# ═══════════════════════════════════════════════════════════════════
#
# Uses the official pre-built llama.cpp CUDA image — NO source compilation.
# Just sets model path and server flags. Builds in seconds.
#
# GPU: Required
# VRAM: ~13.6 GB (model + 32K q4_0 KV cache)
# Port: 8006 (OpenAI-compatible API)
# ═══════════════════════════════════════════════════════════════════

FROM ghcr.io/ggml-org/llama.cpp:server-cuda

LABEL org.opencontainers.image.title="TTS Lab — Qwen 3.6 LLM"
LABEL org.opencontainers.image.description="Qwen 3.6 27B via llama.cpp — reasoning & coding"
LABEL tts-lab.tier="3-engine"
LABEL tts-lab.stack="llm"
LABEL tts-lab.gpu="required"

RUN mkdir -p /opt/models/llm

EXPOSE 8006

HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=60s \
    CMD curl -f http://localhost:8006/health || exit 1

# Defaults match the deployed configuration (see 08-QWEN36-DEPLOYMENT.md):
# Qwen3.6-27B Q3_K_M (~13 GB) with 32K context and q4_0 KV cache.
ENV MODEL_PATH=/opt/models/llm/Qwen-Qwen3.6-27B-Q3_K_M.gguf
ENV CTX_SIZE=32768

ENTRYPOINT ["/bin/sh", "-c"]
CMD ["exec llama-server \
    --model ${MODEL_PATH:-/opt/models/llm/Qwen-Qwen3.6-27B-Q3_K_M.gguf} \
    --host 0.0.0.0 \
    --port 8006 \
    --n-gpu-layers 99 \
    --ctx-size ${CTX_SIZE:-32768} \
    --parallel 1 \
    --cache-type-k q4_0 \
    --cache-type-v q4_0 \
    --flash-attn on \
    --jinja \
    --threads 4 \
    --threads-batch 8"]
