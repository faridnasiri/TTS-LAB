# syntax=docker/dockerfile:1
# ═══════════════════════════════════════════════════════════════════
# SGLang-Omni container — Fish S2-Pro 5B (sm_120 / Blackwell)
# ═══════════════════════════════════════════════════════════════════
#
# Replaces the old custom SGLang image (sglang[all] pins cu128 nvidia-*
# wheels; force-reinstalling torch nightly cu130 onto it broke on
# nvidia-nvjitlink conflicts — S2-Pro stayed blocked since 2026-06-23).
# sglang-omni 0.1.3 ships day-0 S2-Pro support with the whole graph on
# CUDA 13: flashinfer[cu13] 0.6.14, nixl-cu13, mooncake-cuda13, and
# cutlass-dsl 4.6 (pyproject comments: "the generic nixl/-cu12 wheel
# breaks on cu130" — the ecosystem is DESIGNED for cu130).
#
# DEVEL base (not -runtime): flashinfer 0.6.14 is a pure-python wheel
# that JIT-compiles kernels on first use (upstream ships a prebuilt
# cache for SM89/90a only — sm_120 compiles its own), and flash-attn-4
# (beta, >=4.0.0b18) ships NO prebuilt wheels. Both need nvcc.
#
# SIZE: ~25 GB · VRAM: ~11 GB (S2-Pro 5B, always-resident)
# ═══════════════════════════════════════════════════════════════════
# NOTE: do NOT retag this file as `tts-lab-sglang:latest` — that tag is
# still used by the vibevoice/higgs POC services (old launch_server
# entrypoint). s2pro uses `tts-lab-sglang-omni:latest`.

FROM nvidia/cuda:12.8.2-devel-ubuntu22.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 python3.10-dev curl git \
    && rm -rf /var/lib/apt/lists/* \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.10

# ── SGLang-Omni 0.1.3 (cu13-aligned, sm_120-validated) ──────────────
# One coherent resolution: torch==2.11.0, transformers 5.12.1,
# flashinfer[cu13]==0.6.14, nixl-cu13, mooncake-cuda13,
# torchcodec==0.11.1, protobuf 6.30.2 (via nvidia-cutlass-dsl 4.6.0).
# --pre: flash-attn-4 is a beta and source-builds against the nvcc above.
RUN pip install --no-cache-dir --pre "sglang-omni==0.1.3"

# ── S2-Pro's Descript DAC codec ─────────────────────────────────────
# Not bundled in sglang-omni (cookbook adds it). Installed --no-deps:
# descript-audiotools pins protobuf<3.20 (metadata-only — audiotools
# never imports protobuf), which would downgrade cutlass-dsl's
# protobuf>=6.30.2 and break flashinfer's JIT path. The --no-deps
# install is supplemented with audiotools' import-critical deps (all
# verified against the wheel's actual import sites): julius, randomname,
# pyloudnorm (core dsp/loudness), flatten-dict (core.util — import-time),
# ffmpy (AudioSignal -> core.ffmpeg, ref-WAV processing at runtime),
# tensorboard (ml.decorators -> torch.utils.tensorboard at import time),
# argbind + einops (dac/__init__ -> utils -> argbind; dac.nn via EXTERN).
RUN pip install --no-cache-dir --no-deps \
        "descript-audiotools==0.7.2" \
        "descript-audio-codec==1.0.0" \
    && pip install --no-cache-dir julius randomname pyloudnorm flatten-dict ffmpy tensorboard argbind einops

# ── torch cu130 stable — same 2.11 ABI as the sglang-omni pin ───────
# The pin (torch==2.11.0, PyPI cu128) fails on this GPU twice over:
# sglang's sm_120 gate requires torch built with CUDA >= 12.9. The cu130
# index carries the SAME torch version as a +cu130 build — identical C++
# ABI (sgl_kernel's prebuilt .so links it), CUDA 13.0 runtime
# (VM-validated 2026-08-22: capability (12,0), matmul OK). The torch
# 2.15.dev nightly broke sgl_kernel ("undefined symbol
# c10_cuda_check_implementation") — this stays pinned.
# torchvision 0.26.0+cu130 and torchaudio 2.11.0+cu130 match the pins;
# torchcodec 0.11.1 (the pin, torch-2.11 ABI) comes back from PyPI.
RUN pip install --no-cache-dir --force-reinstall \
        torch==2.11.0+cu130 torchaudio==2.11.0+cu130 torchvision==0.26.0+cu130 \
        --index-url https://download.pytorch.org/whl/cu130 \
    && pip install --no-cache-dir --force-reinstall torchcodec==0.11.1

# ── pip nvcc 13.4 on PATH — flashinfer's SM-12.x gate reads nvcc ────
# flashinfer's is_cuda_version_at_least("12.9") runs `nvcc --version`
# (pytorch cpp_extension pattern) to decide if SM-12.x kernels can be
# targeted. The base image's apt nvcc is CUDA 12.8 — first on PATH — so
# the arch normalization raised "SM 12.x requires CUDA >= 12.9", the
# TARGET_CUDA_ARCHS set stayed empty, and CUDA-graph capture died with
# "FlashInfer requires GPUs with sm75 or higher" (crash loop, 2026-08-22).
# nvcc 12.8 also can't emit compute_120f cubins (needs CUDA >= 12.9).
# The cu130 torch pulled nvidia-cuda-nvcc 13.4.46 as nvidia/cu13/bin/nvcc
# — put it first on PATH (GPU-validated: is_cuda_version_at_least
# ("12.9") → True). Placed here so the heavy pip layers stay cached.
ENV PATH=/usr/local/lib/python3.10/dist-packages/nvidia/cu13/bin:$PATH

# ── FFmpeg system libs (torchcodec dlopens them at import) ──────────
# torchcodec 0.11.1 probes libavutil.so.56-60 at import time
# (libtorchcodec_core*.so dlopen) and the nvidia/cuda base ships no
# ffmpeg — the smoke below died on "cannot open shared object file:
# libavutil.so.60". Needed at runtime too: the s2pro pipeline decodes
# audio through torchcodec. Separate RUN keeps the pip steps cached.
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# ── Build-time smoke test ───────────────────────────────────────────
# No GPU during build — this verifies the pip graph + ABI only; kernel
# loading (sm_120 flashinfer JIT) is validated at container start.
# NOTE: descript-audio-codec 1.0.0 renamed its module to `dac` (the
# sglang-omni s2pro pipeline imports dac.model.base / dac.nn.layers /
# audiotools.ml — the 0.1.x `descript_audio_codec` name is gone).
RUN python3.10 -c "import torch, sglang, sglang_omni, torchcodec, dac, audiotools; print('sglang-omni smoke OK:', torch.__version__)"

# ── S2-Pro pipeline config (sgl-project/sglang-omni examples/configs)
# Path is repo-root-relative (context = repo root, as in compose/Makefile).
COPY docker/s2pro_tts.yaml /opt/s2pro_tts.yaml

ENV HF_HOME=/opt/models/huggingface \
    FLASHINFER_WORKSPACE_BASE=/root \
    FLASHINFER_JIT_DEBUG=0

EXPOSE 8000

ENTRYPOINT ["sgl-omni", "serve"]
CMD ["--model-path", "fishaudio/s2-pro", "--config", "/opt/s2pro_tts.yaml", "--host", "0.0.0.0", "--port", "8000"]
