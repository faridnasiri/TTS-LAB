# syntax=docker/dockerfile:1
# ═══════════════════════════════════════════════════════════════════
# Engine-FA — Persian-native engines (ParsVoice-XTTS fine-tune)
# ═══════════════════════════════════════════════════════════════════
#
# WHY A SEPARATE STACK: coqui-tts (XTTS) installs but cannot synthesize
# on the lab's torch nightly (stack:current — "torchcodec vs torch
# nightly", XTTS sits SKIPPED in the UI). This container pins the same
# stable torch the editx stack uses and installs coqui-tts WITHOUT its
# optional `codec` extra, so torchcodec never enters the picture:
#
#   python       3.12 (ubuntu24.04 default; coqui-tts needs >=3.10,<3.15)
#   torch        2.13.0+cu130 stable (sm_120-capable — first stable
#                torch that runs on the RTX 5060 Ti; same pin as editx)
#   coqui-tts    0.27.x (torch NOT bundled since 0.27.4 — we install it;
#                torchcodec is only the `codec`/`codec-cuda` extra)
#   transformers >=4.57 (coqui-tts pin — tf 4.x, unlike stack:current 5.x)
#   model        MohammadJRanjbar/ParsVoice-XTTS — GATED repo (contact-
#                info gate): HF_TOKEN must belong to an account that
#                accepted access. ~1.8 GB into the shared
#                /opt/models/huggingface cache. CPML license (no comm.)
#
# SIZE: ~7 GB · VRAM: ~2 GB (XTTS v2, lazy-loaded, /evict-able)
# ═══════════════════════════════════════════════════════════════════

FROM nvidia/cuda:12.8.2-runtime-ubuntu24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-dev python3-pip curl git ffmpeg libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

# ── torch 2.13.0+cu130 stable (sm_120) ─────────────────────────────
RUN pip install --no-cache-dir \
    torch==2.13.0+cu130 torchaudio==2.11.0+cu130 torchvision==0.28.0+cu130 \
    --index-url https://download.pytorch.org/whl/cu130

# ── coqui-tts 0.27.x (no codec extra → no torchcodec dep) ──────────
RUN pip install --no-cache-dir coqui-tts

# numpy: coqui-tts floors at >=1.26; keep <2.0 (lab-wide ABI rule).
RUN pip install --no-cache-dir "numpy>=1.26,<2.0"

# ── Build-time smoke test ──────────────────────────────────────────
# Torch must be the stable sm_120-capable pair; TTS must import.
RUN python3 -c "\
import torch; \
assert torch.__version__.startswith('2.13'), torch.__version__; \
import TTS; \
print('engine-fa smoke OK: torch', torch.__version__, '| coqui-tts', getattr(TTS, '__version__', '?'))"

# ── Lab engine-server wrapper ──────────────────────────────────────
# NOTE: raw nvidia/cuda base (no tts-lab-base) — every lab file must be
# listed explicitly (same pattern as Dockerfile.engine-editx).
ARG CACHEBUST=0
COPY tts_lab_shims.py /opt/arthur/
COPY tts_lab_config.py /opt/arthur/
COPY tts_lab_utils.py /opt/arthur/
COPY tts_lab_engine_server.py /opt/arthur/
COPY tts_lab_engines.py /opt/arthur/
COPY tts_lab_dispatch.py /opt/arthur/

EXPOSE 8106
HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=60s \
    CMD curl -f http://localhost:8106/health || exit 1
CMD ["python3", "/opt/arthur/tts_lab_engine_server.py", "--port", "8106", "--stack", "fa"]
